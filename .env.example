# Required for automatic first-start embeddings and campaign model calls.
OPENAI_API_KEY=
FIRECRAWL_API_KEY=

# Docker host ports. The frontend proxies /api to the backend.
FRONTEND_PORT=5173
BACKEND_PORT=8000

# Backend defaults also work outside Docker, relative to the project root.
MAGI_DATABASE_URL=sqlite:///./data/magi.db
MAGI_BRAND_SOURCE_DIR=./wickhold-candidate-package/candidate

# Relative source subdirectories; must be distinct and non-overlapping.
MAGI_DOCUMENT_DIRECTORY=brand
MAGI_IMAGE_DIRECTORY=images
MAGI_BRIEF_DIRECTORY=briefs

# Local account IDs used by the backend container (check with id -u / id -g).
MAGI_UID=1000
MAGI_GID=1000

# Per-call OpenAI timeout; SDK automatic retries are disabled.
MAGI_OPENAI_TIMEOUT_SECONDS=60

# Structured brief analysis and retrieval planning.
MAGI_RETRIEVAL_PLANNER_MODEL=gpt-4.1-mini
MAGI_CONFLICT_REVIEW_MODEL=gpt-6-luna

# Enable tool-based campaign chat orchestration.
MAGI_CAMPAIGN_AGENT_ENABLED=true

# Display label for first import; brand content always comes from mounted sources.
MAGI_BRAND_NAME=Wickhold
